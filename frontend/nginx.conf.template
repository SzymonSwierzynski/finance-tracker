# nginx serves the built SPA and reverse-proxies /api to the backend. Serving the app and the API
# from one origin keeps the refresh cookie first-party (SameSite=Lax), exactly like Vite's dev proxy
# — see CLAUDE.md §5 and HANDOFF §21 (3.5b #6). No CORS, no cookie rewriting needed.
#
# This is an envsubst TEMPLATE (nginx:alpine expands /etc/nginx/templates/*.template at boot).
# Only ${FT_*} vars are substituted — NGINX_ENVSUBST_FILTER in the Dockerfile protects nginx's own
# runtime vars ($host, $request_uri, …) from being blanked. Two knobs, so one file serves both
# Docker Compose and a platform with different internal DNS (e.g. Railway):
#   (that's the only knob — DNS is left to the system resolver, see the /api/ block below)
#   FT_API_UPSTREAM  backend hostname        compose: "backend"
#                                            railway: "backend.railway.internal"
server {
    # Fixed port 80 on BOTH stacks. Deliberately not templated from $PORT: platforms let you set the
    # route's target port instead, and templating it here only added a way for the container to die
    # at boot. On Railway set the domain's target port to 80.
    #
    # The IPv6 line is REQUIRED on Railway: its proxy dials the container over IPv6, so an IPv4-only
    # bind answers nothing and the edge returns "Application failed to respond". The nginx image's
    # own 10-listen-on-ipv6-by-default.sh cannot help — it runs BEFORE 20-envsubst-on-templates.sh
    # renders this file, so it patches the stock conf that we then overwrite. Bind both explicitly.
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Bound request bodies — defence-in-depth for the JSON restore endpoint (the backend also caps
    # it). Generous enough for a full backup, small enough to blunt a body-size DoS.
    client_max_body_size 16m;

    # Baseline security headers. NOTE: nginx does NOT inherit `add_header` into a location that
    # declares its own `add_header`, so these three are repeated in the /assets/ and / blocks below.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Reverse-proxy the API to the backend service on the internal network. proxy_pass carries no
    # URI part, so nginx forwards the original path untouched — keeping the /api prefix the backend
    # serves under, plus the query string.
    location /api/ {
        # STATIC upstream on purpose. A variable upstream + `resolver` makes nginx do its own DNS,
        # which could not resolve *.railway.internal (AAAA-only) however it was tuned. Naming the
        # host directly makes nginx resolve once at startup via getaddrinfo/resolv.conf — the same
        # system resolver the backend already uses successfully for postgres.railway.internal.
        # Trade-off: nginx re-resolves only on restart, and won't start if the name is wrong (which
        # is a clearer failure than a runtime 502).
        proxy_pass http://${FT_API_UPSTREAM}:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # OVERWRITE (not append) X-Forwarded-For with the real peer, so a client-supplied header can't
        # spoof the IP the auth rate limiter keys on. nginx is the only trusted hop; keep the backend
        # off the public internet (compose binds :8080 to localhost; on Railway give the backend
        # service NO public domain).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Fingerprinted build assets can be cached hard; they change name on every build.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # SPA history fallback: unknown paths return index.html so client-side routing survives reloads
    # and deep links (/breakdown, /transactions, …). The shell must NOT be cached, or clients keep a
    # stale index.html (pointing at old asset hashes) after a redeploy.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
