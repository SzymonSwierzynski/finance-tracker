# Env / secrets
.env
.env.*
!.env.example
# Build-time public config for the SPA — no secrets, and it MUST be committed or the deployed
# bundle ships with an empty API base URL.
!frontend/.env.production
# Deployment key material — the JWT signing pair must never reach the remote.
*.pem
*.key
jwt.pub

# Agent working notes — kept locally, not part of the codebase
HANDOFF.md
review.md
.superpowers/
# Root contract/instructions kept local-only (anchored so reference/.../CLAUDE.md stays tracked)
/CLAUDE.md
/claude.md
